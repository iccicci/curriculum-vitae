{
  "description": "The Curriculum Vitae of Daniele Ricci",
  "name": "curriculum-vitae",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deps": "npm-check-updates -t minor -u && yarn && npm-check-updates -t latest",
    "eslint": "eslint .",
    "preview": "vite preview",
    "packages": "yarn-upgrade-all --ignore-workspace-root-check"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSameLine": false,
    "endOfLine": "lf",
    "printWidth": 150,
    "singleAttributePerLine": false,
    "trailingComma": "none",
    "useTabs": false
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "npm-check-updates": "23.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-router-dom": "^7.18.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
